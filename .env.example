# Copie este arquivo para ".env" e preencha. O .env NUNCA deve ir para o git.

# Endereço do GitLab da empresa (sem barra no final)
GITLAB_URL=https://gitlab.suaempresa.com.br
# Token pessoal do GitLab, escopo "api" (os comentários saem no seu nome)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Coloque false só se o GitLab usar certificado interno e der erro de SSL
GITLAB_VERIFICAR_SSL=true

# Qual Claude usar:
#   claude-code -> usa o Claude Code instalado e logado na sua máquina (sua assinatura, sem chave)
#   api         -> usa uma chave da API da Anthropic (cobrança por uso)
LLM_PROVEDOR=claude-code
# Só para LLM_PROVEDOR=api:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Opcional. Vazio = modelo padrão do Claude Code. Ex.: sonnet, opus
# LLM_MODELO=
# Opcional: caminho do executável, se "claude" não estiver no PATH
# CLAUDE_EXECUTAVEL=claude

# Grupos do GitLab cujos projetos são descobertos automaticamente a cada treino (com subgrupos,
# sem arquivados), separados por vírgula. Pelo menos um entre GRUPOS_TREINO e PROJETOS_TREINO é obrigatório.
GRUPOS_TREINO=attornatus/microservicos
# Projetos avulsos fora dos grupos acima, separados por vírgula (caminho como aparece na URL)
# PROJETOS_TREINO=grupo/projeto-solto
# Usuários do GitLab a ignorar no treino (bots etc.), sem @, separados por vírgula
# REVISORES_EXCLUIDOS=bot.ci,bot.sonar
# Mínimo de comentários de um microserviço para ele ganhar guia próprio, além do guia geral
# MIN_COMENTARIOS_GUIA_MICRO=30
# Dias até o mapa técnico de um microserviço ser considerado vencido e relido
# MAPA_VALIDADE_DIAS=30
# Opcional: projeto do GitLab com as ADRs (decisões de arquitetura) da equipe, ex.: attus/workspace.
# Vazio desliga o recurso. O coordenador passa a considerar contradição a uma ADR, igual já faz com
# o guia de estilo.
# ADR_PROJETO=
# Opcional: pasta dentro do projeto acima onde ficam as ADRs (ex.: docs/adr). Vazio = autodetecção
# (arquivos .md com "adr" no caminho ou nomeados no padrão 0007-titulo.md).
# ADR_CAMINHO=
# Dias até o resumo das ADRs ser considerado vencido e relido
# ADR_VALIDADE_DIAS=30
# Segundos sem atualização de progresso numa revisão para avisar que ela pode ter travado
# LIMITE_INATIVIDADE_SEGUNDOS=60
# Agentes especialistas rodando em paralelo (a assinatura do Claude Code tem limite de uso
# compartilhado). Ainda não usado pelo review (motor dos agentes pronto, falta ligar o coordenador).
# AGENTES_PARALELOS=2
# Turnos (chamadas de ferramenta) que um agente pode usar antes de ser encerrado
# LIMITE_TURNOS_AGENTE=15
# No primeiro treino, buscar MRs a partir desta data (padrão: últimos 12 meses)
# TREINO_DESDE=2025-11-01

# PORTA=8765
